{
  "info": {
    "name": "FitBite - Password Reset",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Luồng mã OTP email 6 chữ số (hiệu lực 15 phút, tối đa 5 lần thử, cooldown 60s), không dùng link reset. Tài khoản test: Phuc.nguyen28102005p@hcmut.edu.vn / Huy Phúc / 123456Phuc!."
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000",
      "type": "string"
    },
    {
      "key": "resetEmail",
      "value": "Phuc.nguyen28102005p@hcmut.edu.vn",
      "type": "string"
    },
    {
      "key": "username",
      "value": "Huy Phúc",
      "type": "string"
    },
    {
      "key": "newPassword",
      "value": "123456Phuc!",
      "type": "string"
    },
    {
      "key": "resetCode",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1) Request reset code via SMTP Email",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{resetEmail}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/users/forgot-password",
        "description": "Gửi mã OTP 6 chữ số tới email tài khoản đã đăng ký qua SMTP Nodemailer. Mã có hiệu lực 15 phút, cooldown gửi lại 60 giây."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const json = pm.response.json();",
              "pm.test('Has success message', function () {",
              "  pm.expect(json).to.have.property('message');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "2) Reset password with 6-digit OTP code",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{resetEmail}}\",\n  \"reset_code\": \"{{resetCode}}\",\n  \"password\": \"{{newPassword}}\",\n  \"confirm_password\": \"{{newPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/users/reset-password",
        "description": "Nhập mã 6 chữ số từ email vào biến resetCode. Mã hết hạn sau 15 phút, chỉ dùng 1 lần, tối đa 5 lần thử sai."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const json = pm.response.json();",
              "pm.test('Has success message', function () {",
              "  pm.expect(json).to.have.property('message');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "3) Login with new password (by Email identifier)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"identifier\": \"{{resetEmail}}\",\n  \"password\": \"{{newPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/users/login",
        "description": "Đăng nhập bằng email và mật khẩu mới. Các phiên đăng nhập cũ trước khi reset đều đã bị thu hồi."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const json = pm.response.json();",
              "pm.test('Returns tokens and role', function () {",
              "  pm.expect(json.result).to.have.property('access_token');",
              "  pm.expect(json.result).to.have.property('refresh_token');",
              "  pm.expect(json.result.role).to.eql('Customer');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "4) Login with new password (by Vietnamese Username identifier)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"identifier\": \"{{username}}\",\n  \"password\": \"{{newPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/users/login",
        "description": "Đăng nhập bằng username tiếng Việt có dấu ('Huy Phúc') và mật khẩu mới."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const json = pm.response.json();",
              "pm.test('Returns tokens and role', function () {",
              "  pm.expect(json.result).to.have.property('access_token');",
              "  pm.expect(json.result).to.have.property('refresh_token');",
              "  pm.expect(json.result.role).to.eql('Customer');",
              "});"
            ]
          }
        }
      ]
    }
  ]
}

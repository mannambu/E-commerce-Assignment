{
  "info": {
    "name": "Fitbite - Password Reset",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Luồng mã email, không dùng link reset. Điền baseUrl, resetEmail, newPassword; chạy từng request thủ công để có thời gian lấy mã từ email."
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "",
      "type": "string"
    },
    {
      "key": "resetEmail",
      "value": "",
      "type": "string"
    },
    {
      "key": "resetCode",
      "value": "",
      "type": "string"
    },
    {
      "key": "newPassword",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1) Request reset code",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{resetEmail}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/users/forgot-password",
        "description": "Gửi mã tới email tài khoản đã đăng ký. HTTP 200 không bảo đảm email tồn tại hoặc đã nhận được thư. Chờ email và điền resetCode trước khi chạy bước 2."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('HTTP 200', function () { pm.response.to.have.status(200); });"]
          }
        }
      ]
    },
    {
      "name": "2) Reset password with email code",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{resetEmail}}\",\n  \"reset_code\": \"{{resetCode}}\",\n  \"password\": \"{{newPassword}}\",\n  \"confirm_password\": \"{{newPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/users/reset-password",
        "description": "Nhập mã 6 chữ số từ email vào resetCode. Mã hết hạn sau 15 phút, chỉ dùng một lần, tối đa 5 lần thử."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('HTTP 200', function () { pm.response.to.have.status(200); });"]
          }
        }
      ]
    },
    {
      "name": "3) Login with the new password",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"identifier\": \"{{resetEmail}}\",\n  \"password\": \"{{newPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/users/login",
        "description": "Đăng nhập bằng mật khẩu mới. Các phiên trước khi reset đã bị thu hồi; tài khoản bị Admin khóa vẫn không thể đăng nhập."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('HTTP 200', function () { pm.response.to.have.status(200); });"]
          }
        }
      ]
    }
  ]
}

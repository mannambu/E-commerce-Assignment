    {
      "name": "2.1 Lấy danh sách món ăn (Foods)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{customerToken}}" }
        ],
        "url": "{{baseUrl}}/foods?page=1&limit=5"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json();",
              "pm.test('Saved foodId', function () {",
              "  const foods = json.result?.foods || json.result || [];",
              "  pm.expect(foods.length).to.be.above(0);",
              "  pm.collectionVariables.set('foodId', foods[0]._id);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "2.2 Thêm món vào giỏ hàng (Cart)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{customerToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"itemId\": \"{{foodId}}\",\n  \"quantity\": 2,\n  \"cartType\": \"FOOD\"\n}"
        },
        "url": "{{baseUrl}}/cart/items"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json();",
              "pm.test('Saved cartVersion', function () {",
              "  const version = json.result?.currentCart?.version ?? 1;",
              "  pm.collectionVariables.set('cartVersion', String(version));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "2.3 Đặt đơn hàng COD",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{customerToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"deliveryAddress\": \"268 Lý Thường Kiệt, Quận 10, TP.HCM\",\n  \"deliveryDate\": \"2026-10-25\",\n  \"deliveryTime\": \"12:00\",\n  \"packageType\": \"ONE_DAY\",\n  \"cartType\": \"FOOD\",\n  \"paymentMethod\": \"COD\",\n  \"cartVersion\": {{cartVersion}},\n  \"idempotencyKey\": \"test_order_{{$timestamp}}\"\n}"
        },
        "url": "{{baseUrl}}/orders"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 201', function () { pm.expect([200, 201]).to.include(pm.response.code); });",
              "const json = pm.response.json();",
              "pm.test('Order created as Pending', function () {",
              "  const ord = json.result;",
              "  pm.expect(ord).to.have.property('_id');",
              "  pm.collectionVariables.set('orderId', ord._id);",
              "  pm.collectionVariables.set('orderVersion', String(ord.version || 0));",
              "  if (ord.deliveries && ord.deliveries.length > 0) {",
              "    pm.collectionVariables.set('deliveryId', ord.deliveries[0]._id);",
              "  }",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "3.1 Manager duyệt đơn",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{managerToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"action\": \"Confirm\",\n  \"reason\": \"Đủ nguyên liệu và bếp sẵn sàng\"\n}"
        },
        "url": "{{baseUrl}}/orders/{{orderId}}/decision"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",

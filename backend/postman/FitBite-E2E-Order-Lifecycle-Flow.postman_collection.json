    {
      "name": "1.1 Admin cấu hình giờ chốt bếp",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cutoffHour\": 23\n}"
        },
        "url": "{{baseUrl}}/admin/commerce-settings"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "1.2 Manager lấy mã Kitchen Staff",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{managerToken}}" }
        ],
        "url": "{{baseUrl}}/workspace/staff?role=Kitchen Staff"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json();",
              "pm.test('Saved kitchenId', function () {",
              "  const list = json.result || [];",
              "  pm.expect(list.length).to.be.above(0);",
              "  pm.collectionVariables.set('kitchenId', list[0]._id);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "1.3 Manager lấy mã Delivery Staff",

    {
      "name": "6.1 Customer đánh giá món ăn",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{customerToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"targetType\": \"Food\",\n  \"targetId\": \"{{foodId}}\",\n  \"rating\": 5,\n  \"comment\": \"Món ăn rất tươi ngon, chuẩn vị healthy FitBite!\"\n}"
        },
        "url": "{{baseUrl}}/reviews"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 201', function () { pm.expect([200, 201]).to.include(pm.response.code); });",
              "const json = pm.response.json();",
              "pm.test('Review created successfully', function () {",
              "  const rev = json.result;",
              "  pm.expect(rev).to.have.property('_id');",
              "  pm.collectionVariables.set('reviewId', rev._id);",
              "});"
            ]
          }

              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json();",
              "pm.test('Order confirmed (Confirmed)', function () {",
              "  pm.expect(json.result.status).to.eql('Confirmed');",
              "});"
            ]
          }
        }
      ]
    },

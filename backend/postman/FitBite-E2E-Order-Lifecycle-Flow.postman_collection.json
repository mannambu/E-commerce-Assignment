{
  "info": {
    "name": "FitBite - E2E Order Lifecycle Flow (5 Roles)",
    "description": "Toàn trình vòng đời đơn hàng FitBite (5 Roles: Customer, Manager, Kitchen Staff, Delivery Staff, Admin) từ đăng nhập, đặt đơn COD, phân công bếp/shipper, giao hàng, đánh giá đến kiểm duyệt.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000" },
    { "key": "customerEmail", "value": "phuc.nguyen28102005p@hcmut.edu.vn" },
    { "key": "customerPassword", "value": "123456Phuc!" },
    { "key": "managerEmail", "value": "manager@fitbite.local" },
    { "key": "managerPassword", "value": "Manager123!" },
    { "key": "kitchenEmail", "value": "kitchen@fitbite.local" },
    { "key": "kitchenPassword", "value": "Kitchen123!" },
    { "key": "shipperEmail", "value": "shipper@fitbite.local" },
    { "key": "shipperPassword", "value": "Shipper123!" },
    { "key": "adminEmail", "value": "admin@fitbite.local" },
    { "key": "adminPassword", "value": "Admin123!" },
    { "key": "customerToken", "value": "" },
    { "key": "managerToken", "value": "" },
    { "key": "kitchenToken", "value": "" },
    { "key": "shipperToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "kitchenId", "value": "" },
    { "key": "shipperId", "value": "" },
    { "key": "foodId", "value": "" },
    { "key": "cartVersion", "value": "0" },
    { "key": "orderId", "value": "" },
    { "key": "deliveryId", "value": "" },
    { "key": "orderVersion", "value": "0" },
    { "key": "reviewId", "value": "" }
  ],
  "item": [
    {
      "name": "0.1 Đăng nhập Customer",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"identifier\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\"\n}"
        },
        "url": "{{baseUrl}}/users/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json();",
              "pm.test('Customer logged in', function () {",
              "  pm.expect(json.result).to.have.property('access_token');",
              "  pm.collectionVariables.set('customerToken', json.result.access_token);",
              "});"
            ]
          }
        }
      ]
    },
